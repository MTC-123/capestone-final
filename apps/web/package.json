{
  "name": "ricer-ifrane",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint src tests --max-warnings=38",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:lighthouse": "npm run build && lhci autorun",
    "db:fix-indexes": "node scripts/db/fix-mongodb-indexes.js",
    "generate:errors": "tsx scripts/generate/generate-error-catalog.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts",
    "scan:semgrep": "semgrep --config .semgrep.yml",
    "scan:zap": "zap-baseline.py -c security/zap-baseline.conf -t http://localhost:3000",
    "perf:k6": "k6 run perf/k6-workload.js",
    "deploy:verify": "tsx scripts/deploy/verify-deploy.ts",
    "ci": "npm run lint && npm run test:unit && npm run test:e2e",
    "prisma:seed:load": "tsx --env-file-if-exists=.env.local prisma/seed-load.ts",
    "db:backup": "bash scripts/db/backup.sh",
    "db:restore": "bash scripts/db/restore.sh",
    "ml:export": "python3 scripts/ml/export_xgboost.py",
    "typegen": "next typegen",
    "test:db": "vitest run --config vitest.db.config.ts",
    "postinstall": "node scripts/setup/copy-maplibre-worker.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/maplibre": "^9.4.0",
    "@prisma/client": "^5.22.0",
    "@protomaps/basemaps": "^5.7.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@sentry/nextjs": "^11.0.0",
    "@turf/area": "^7.3.4",
    "@turf/bbox": "^7.3.4",
    "@turf/centroid": "^7.3.4",
    "@turf/helpers": "^7.3.4",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/blob": "^2.8.0",
    "ably": "^2.17.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.11.1",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.0",
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.11.2",
    "next": "^16.3.6",
    "ol": "^10.10.0",
    "ol-pmtiles": "^2.0.2",
    "pmtiles": "^4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "recharts": "^2.15.0",
    "resend": "^6.28.1",
    "tailwind-merge": "^3.5.0",
    "twilio": "^5.11.2",
    "zod": "^3.25.76",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jsdom": "^25.0.1",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
