# RICER Ifrane: environment template
# Copy to .env.local and fill in. Never commit real values.

# --- Core -------------------------------------------------------------
DATABASE_URL=            # MongoDB connection string (Prisma)
JWT_SECRET=              # long random string; signs access tokens
REFRESH_TOKEN_PEPPER=    # long random string; hashes refresh tokens
BASE_URL=http://localhost:3000

# --- Maps and environmental data -------------------------------------
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAPTILER_API_KEY=
NEXT_PUBLIC_OWM_API_KEY= # OpenWeatherMap
FIRMS_MAP_KEY=           # NASA FIRMS map key
GRAPHHOPPER_URL=         # routing endpoint

# --- Messaging and realtime ------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=  # e.g. whatsapp:+14155238886 (sandbox)
TEST_PHONE_NUMBER=       # recipient for notification smoke tests
ABLY_API_KEY=
REDIS_URL=               # notification queue

# --- Observability ---------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Demo mode (never enable in production) --------------------------
DEMO_AUTO_LOGIN_ENABLED=false
DEMO_ADMIN_CIN=
ACCESS_TOKEN=
