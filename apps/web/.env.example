# RICER Ifrane — environment template
# Copy to .env.local for development; set the same keys in Vercel → Project →
# Settings → Environment Variables for deployments. Never commit real values.
#
# Every integration below the "Core" block is optional: the app runs without
# it and shows the affected feature as unavailable.

# ── Core (required) ──────────────────────────────────────────────────────
# MongoDB Atlas M0 (free) connection string. Include the database name.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/ricer?retryWrites=true&w=majority"
# 64+ random characters each:  openssl rand -hex 48
JWT_SECRET=
REFRESH_TOKEN_PEPPER=
# Public origin of the deployment (used in notification links).
BASE_URL=http://localhost:3000

# ── Demo mode (showcase deployment only) ─────────────────────────────────
# "true" enables one-click persona sign-in (/demo/map?as=official|civilian),
# the styleguide and the error catalogue. Leave unset for real deployments.
DEMO_MODE=

# ── Shared cache, rate limits and background jobs (recommended) ──────────
# Upstash Redis (free): console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Upstash QStash (free) — delivers email/WhatsApp notifications with retries.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Photo storage (recommended) ──────────────────────────────────────────
# Vercel Blob (free on Hobby). Without it, photos are stored in MongoDB.
BLOB_READ_WRITE_TOKEN=

# ── Maps and environmental data (optional) ───────────────────────────────
# Basemaps default to CARTO/OpenStreetMap and terrain to AWS Terrarium (no key).
NEXT_PUBLIC_MAPTILER_API_KEY=
# NASA FIRMS satellite fire detections: firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_MAP_KEY=
# OpenWeatherMap weather tiles: home.openweathermap.org/api_keys
NEXT_PUBLIC_OWM_API_KEY=
# Road routing. Falls back to straight-line estimates when unset.
# Either a self-hosted GraphHopper URL or a GraphHopper Cloud key (free tier).
GRAPHHOPPER_URL=
GRAPHHOPPER_API_KEY=
# Place search in Arabic/French: locationiq.com
LOCATIONIQ_API_KEY=

# ── Notifications (optional) ─────────────────────────────────────────────
# Realtime in-app updates: ably.com
ABLY_API_KEY=
# Email: resend.com (sends from onboarding@resend.dev unless RESEND_FROM is a verified domain)
RESEND_API_KEY=
RESEND_FROM=
# WhatsApp via the Twilio sandbox: recipients must first send the join code.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Extra WhatsApp recipient for demos (E.164, e.g. +2126XXXXXXXX)
TEST_PHONE_NUMBER=

# ── Observability (optional) ─────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Advanced ─────────────────────────────────────────────────────────────
# Extra hosts allowed to call server actions (comma-separated).
SERVER_ACTIONS_ALLOWED_ORIGINS=
# Register the service worker in development.
NEXT_PUBLIC_ENABLE_SW=
